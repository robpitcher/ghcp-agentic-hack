{
  "name": "ghcp-video-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @ghcp/content-cli content build",
    "content": "pnpm --filter @ghcp/content-cli content",
    "minimax:h3": "node --env-file=.env scripts/minimax-h3-poc.mjs",
    "review:slides": "node scripts/preview-local.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "validate": "pnpm --filter @ghcp/content-cli content validate"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "slidev-theme-ghcp": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
