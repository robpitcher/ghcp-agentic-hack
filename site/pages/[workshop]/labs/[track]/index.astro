---
import Base from '../../../../layouts/Base.astro'
import { existsSync } from 'node:fs'
import { resolve } from 'node:path'
import { renderLabMarkdown } from '../../../../lib/lab'
import { resolveModuleSkillTracks, workshopMeta, type ModuleSkillTrack } from '../../../../data/workshops'

interface TrackLabProps {
  html: string
  title: string
  toc: { id: string; text: string }[]
  moduleLabel: string
  track: ModuleSkillTrack
}

export function getStaticPaths() {
  const workshopsDir: string = __WORKSHOPS_DIR__
  const showDrafts: boolean = __SHOW_DRAFTS__
  const paths: { params: { workshop: string; track: string }; props: TrackLabProps }[] = []

  for (const meta of Object.values(workshopMeta)) {
    for (const module of meta.modules ?? []) {
      const moduleDir = resolve(workshopsDir, module.folder)
      if (!existsSync(moduleDir)) continue
      if (!showDrafts && existsSync(resolve(moduleDir, '.draft'))) continue

      for (const track of resolveModuleSkillTracks(workshopsDir, module.folder).filter(candidate => candidate.slug !== 'general' && candidate.labPath)) {
        const { html, title, toc } = renderLabMarkdown(track.labPath!, { stripTitleHeading: true })
        paths.push({
          params: { workshop: module.folder, track: track.slug },
          props: { html, title, toc, moduleLabel: module.label, track }
        })
      }
    }
  }

  return paths
}

const { html, title, toc, moduleLabel, track } = Astro.props
const base = import.meta.env.BASE_URL
const exerciseCount = toc.filter(t => /exercise|lab\s+\d/i.test(t.text)).length || toc.length
---

<Base title={title}>
  <div class="track-banner">
    <div>
      <p class="track-eyebrow">{moduleLabel} skill-track lab</p>
      <h1>{track.icon} {title}</h1>
      <p><strong>{track.label}</strong>: {track.description}</p>
      {track.skill && (
        <a href={`${base}copilot-dev-training/skills/${track.skill.slug}/`} class="track-skill-link">Review required skill guidance</a>
      )}
    </div>
  </div>

  <div class="lab-layout">
    {toc.length > 1 && (
      <nav class="lab-toc" aria-label="Table of contents">
        <div class="toc-header">Contents</div>
        <div class="toc-progress">
          <span class="toc-progress-text">{exerciseCount} exercises</span>
        </div>
        <ul class="toc-list">
          {toc.map((item) => (
            <li>
              <a href={`#${item.id}`} class="toc-link">{item.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <article class="lab-content prose" set:html={html} />
  </div>
</Base>

<style is:global>
  .lab-content pre {
    background: #0d1117 !important;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
    margin: 0 0 16px;
    position: relative;
  }
  .lab-content pre code {
    background: none !important;
    border: none !important;
    padding: 0 !important;
    font-size: 0.875em;
    color: #e6edf3;
  }
  .lab-content code {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
  }
  .lab-content :not(pre) > code {
    background: var(--bg-soft, #f0f2f5);
    border: 1px solid var(--border, #d0d7de);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.9em;
  }
  .hljs { color: #e6edf3; }
  .hljs-comment, .hljs-quote { color: #8b949e; font-style: italic; }
  .hljs-keyword, .hljs-selector-tag { color: #ff7b72; }
  .hljs-string, .hljs-addition { color: #a5d6ff; }
  .hljs-number, .hljs-literal { color: #79c0ff; }
  .hljs-built_in { color: #ffa657; }
  .hljs-type, .hljs-class .hljs-title { color: #ffa657; }
  .hljs-attr, .hljs-variable, .hljs-template-variable { color: #79c0ff; }
  .hljs-symbol, .hljs-bullet { color: #f2cc60; }
  .hljs-section, .hljs-title { color: #d2a8ff; }
  .hljs-meta { color: #79c0ff; }
  .hljs-deletion { color: #ffa198; background: rgba(248,81,73,0.1); }
  .hljs-addition { background: rgba(63,185,80,0.1); }
  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 8px;
    border: 1px solid #30363d;
    border-radius: 6px;
    background: #21262d;
    color: #8b949e;
    cursor: pointer;
    font-size: 12px;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.15s;
    z-index: 1;
  }
  pre:hover .copy-btn { opacity: 1; }
  .copy-btn:hover { color: #e6edf3; border-color: #8b949e; }
  .copy-btn.copied { color: #3fb950; border-color: #3fb950; }
</style>

<style>
  .track-banner {
    max-width: 1200px;
    margin: 0 auto 24px;
    padding: 24px;
    border: 1px solid rgba(9, 105, 218, 0.22);
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(9, 105, 218, 0.08), rgba(9, 105, 218, 0.03));
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: flex-start;
  }
  .track-eyebrow {
    color: #0969da;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0 0 6px;
    text-transform: uppercase;
  }
  .track-banner h1 {
    color: var(--text-1);
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.1;
    margin: 0 0 8px;
  }
  .track-banner p {
    color: var(--text-2);
    margin: 0 0 14px;
  }
  .track-skill-link {
    display: inline-block;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  .track-skill-link {
    background: #0969da;
    color: #fff;
    padding: 8px 14px;
  }
  .lab-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: start;
  }
  @media (max-width: 900px) {
    .lab-layout {
      grid-template-columns: 1fr;
    }
    .lab-toc { display: none; }
    .track-banner { flex-direction: column; }
  }
  .lab-toc {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding: 16px 0;
  }
  .toc-header {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-2);
    padding: 0 12px 8px;
  }
  .toc-progress {
    padding: 0 12px 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .toc-progress-text {
    font-size: 13px;
    color: var(--text-2);
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-list li { margin: 0; }
  .toc-link {
    display: block;
    padding: 6px 12px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-2);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .toc-link:hover {
    color: var(--text-1);
    background: var(--bg-soft);
  }
  .toc-link.active {
    color: var(--brand);
    border-left-color: var(--brand);
    font-weight: 600;
  }
  .lab-content {
    min-width: 0;
    padding: 16px 0 64px;
  }
</style>

<script>
  document.querySelectorAll('pre').forEach(pre => {
    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      const text = (code || pre).textContent || '';
      await navigator.clipboard.writeText(text);
      btn.textContent = 'Copied!';
      btn.classList.add('copied');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    });
    pre.appendChild(btn);
  });

  const tocLinks = document.querySelectorAll('.toc-link');
  const headings = Array.from(tocLinks).map(link => {
    const id = link.getAttribute('href')?.slice(1);
    return id ? document.getElementById(id) : null;
  }).filter(Boolean) as HTMLElement[];

  function updateActiveToc() {
    let activeIndex = 0;
    const scrollY = window.scrollY + 120;
    for (let i = headings.length - 1; i >= 0; i--) {
      if (headings[i].offsetTop <= scrollY) { activeIndex = i; break; }
    }
    tocLinks.forEach((link, i) => {
      link.classList.toggle('active', i === activeIndex);
    });
  }
  window.addEventListener('scroll', updateActiveToc, { passive: true });
  updateActiveToc();
</script>
